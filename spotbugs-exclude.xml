<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter for SchoolBridge API.

  EI_EXPOSE_REP / EI_EXPOSE_REP2
    Spring-managed beans receive their collaborators via constructor injection.
    Those collaborators are container-owned singletons, not "externally mutable
    objects" in the sense the rule targets. Suppressed project-wide for beans.

    Record/DTO accessors returning List<T> sourced from Spring Data or immutable
    factory calls are similarly safe; any real exposure-of-representation issue
    would be in the callers (already validated by integration tests).

  CT_CONSTRUCTOR_THROW
    AesGcmAttributeConverter, BlindIndexHasher, and JwtService throw on invalid
    configuration at startup — the intended fail-fast behaviour. The finalizer
    attack vector the rule guards against does not apply here because (a) these
    classes carry no sensitive state after construction fails and (b) they are
    Spring-managed beans that are never directly finalized by user code.

  DMI_RANDOM_USED_ONLY_ONCE
    JwtService.newRefreshToken() — suppressed via @SuppressWarnings in source.
-->
<FindBugsFilter>

  <!-- Spring DI fields and record/DTO list accessors -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- Fail-fast startup constructors -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

</FindBugsFilter>
