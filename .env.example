# SchoolBridge environment variables — copy to .env and fill in.
# NOTHING in this file is a real value. Every secret below is env-only by design:
# application.yml deliberately carries no defaults for them, so a missing variable
# fails at startup instead of silently running on a key that is public in this repo.

# ---------------------------------------------------------------------------
# Required in every profile except local/test
# ---------------------------------------------------------------------------

# 32-byte keys, base64-encoded. Generate with:
#   openssl rand -base64 32
# Rotating AES_KEY makes existing encrypted columns unreadable — plan a re-encryption
# before you change it. BLIND_INDEX_KEY has the same property for phone lookups.
AES_KEY=
BLIND_INDEX_KEY=

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
# Docker Compose infrastructure values.
POSTGRES_DB=schoolbridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5434
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
REDIS_HOST_PORT=6379
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Two database identities in prod, on purpose. DB_USERNAME is the least-privilege runtime role;
# DB_MIGRATION_USERNAME owns the tables and runs Liquibase. PostgreSQL lets a table owner bypass
# row-level security, so running the app as the owner would silently switch off every tenant
# isolation policy from changelog 017 — RlsStartupValidator fails the boot if you do.
# Role setup SQL: docs/RUNBOOK.md, "Database roles". Local dev and tests use one role for both.
DB_URL=jdbc:postgresql://localhost:5432/schoolbridge
DB_USERNAME=
DB_PASSWORD=
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# ---------------------------------------------------------------------------
# JWT (staff auth). PEM-encoded RSA keypair.
# Leave blank in local dev and an ephemeral keypair is generated at startup —
# tokens then stop verifying after a restart, which is fine locally and not in prod.
# ---------------------------------------------------------------------------
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta). From developers.facebook.com → your app → WhatsApp → API Setup.
# WHATSAPP_APP_SECRET is the HMAC key that authenticates the inbound webhook; treat it
# with the same care as a password. Without an access token the app falls back to
# LoggingWhatsAppClient and sends nothing.
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Attachment object storage (S3-compatible). Leave STORAGE_ENDPOINT blank for real AWS S3;
# set it for MinIO (http://localhost:9000 against docker-compose) or Cloudflare R2.
# STORAGE_PATH_STYLE must stay true for MinIO on a bare host — the virtual-host address form
# has no DNS to resolve against there.
#
# The bucket MUST NOT be public. Every read is a short-lived presigned GET issued by the API
# after an authorization check; a public bucket makes the object keys the only secret, and keys
# are predictable from a school id.
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=schoolbridge-attachments
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PATH_STYLE=true
STORAGE_MAX_UPLOAD_BYTES=10485760

# ClamAV (clamd). Required in production — the app refuses to start with the prod profile and
# STORAGE_AV_ENABLED=false, because an unscanned file served back to a parent is the whole risk
# this pipeline exists to manage. Run clamav/clamav and point the host at it.
STORAGE_AV_ENABLED=true
STORAGE_AV_HOST=
STORAGE_AV_PORT=3310

# ---------------------------------------------------------------------------
# AI assistant — OFF by default and intended to stay that way until the
# data-processing question is settled (ADR-007). Enabling it sends tool results,
# which include student names, attendance and grades, to a third-party inference
# endpoint. Spring AI is the only engine; there is no ASSISTANT_ENGINE variable.
# ---------------------------------------------------------------------------
ASSISTANT_ENABLED=false
ASSISTANT_ACTIONS_ENABLED=false
ASSISTANT_RAG_ENABLED=false
# Set to a provider (e.g. openai) only when ASSISTANT_ENABLED=true.
SPRING_AI_CHAT=none
OPENAI_BASE_URL=https://integrate.api.nvidia.com
OPENAI_API_KEY=
ASSISTANT_MODEL=deepseek-ai/deepseek-v4-flash

# ---------------------------------------------------------------------------
# Rate limiting. Defaults are in application.yml; override per environment.
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTHENTICATED=120
RATE_LIMIT_ANONYMOUS=20
# Each OTP request costs a real WhatsApp template or SMS send.
OTP_MAX_PER_HOUR=3
OTP_MAX_PER_DAY=10
