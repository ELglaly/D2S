{
  "permissions": {
    "allow": [
      "Bash(mvn -B -ntp:*)",
      "Bash(mvn spotless:apply)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NonInteractive -Command \"cd E:\\D2L; mvn -q spotless:apply\"",
            "description": "Auto-apply Spotless formatting after every file write/edit"
          }
        ]
      }
    ]
  }
}
